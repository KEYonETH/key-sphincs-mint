# KEY production backend/frontend template
# Copy this file to .env.production on the server.
# Do not commit .env.production and do not paste private keys into chat.

# Frontend build-time values
VITE_BACKEND_URL=https://api.your-domain.example
VITE_CHAIN_ID=1
VITE_MINT_GATE_ADDRESS=
VITE_KEY_TOKEN_ADDRESS=
VITE_TREASURY_VAULT_ADDRESS=
VITE_LP_RESERVE_ADDRESS=
VITE_TREASURY_RESERVE_ADDRESS=
VITE_CONTRACT_OWNER_ADDRESS=
VITE_UNISWAP_V4_POOL_ID=not created
VITE_UNISWAP_V4_HOOK_ADDRESS=

# Backend runtime values
NODE_ENV=production
PORT=8787
CORS_ORIGIN=https://your-domain.example
CHAIN_ID=1
MINT_GATE_ADDRESS=
KEY_MINT_GATE_ADDRESS=
KEY_TOKEN_ADDRESS=
KEY_IDENTITY_ADDRESS=
KEY_REGISTRAR_ADDRESS=
KEY_MARKET_ADDRESS=
TREASURY_VAULT_ADDRESS=
LP_RESERVE_RECIPIENT=
TREASURY_RESERVE_RECIPIENT=
CONTRACT_OWNER_ADDRESS=
UNISWAP_V4_POOL_ID=not created
UNISWAP_V4_HOOK_ADDRESS=
UNISWAP_V4_POOL_MANAGER=0x000000000004444c5dc75cB358380D2e3dE08A90
UNISWAP_V4_INITIALIZE_TX=
UNISWAP_V4_INITIAL_PRICE=1 ETH = 500,000 KEY
UNISWAP_V4_FEE=10000
UNISWAP_V4_TICK_SPACING=200
PROOF_DATA_DIR=./backend/data
PROOF_BACKUP_DIR=./backend/data/backups
PROOF_BACKUP_KEEP=30
CHALLENGE_TTL_MS=600000
SIGNER_PRIVATE_KEY=
MAINNET_RPC_URL=
RPC_URL=
PYTHON=python3

# Public traffic guardrails
GLOBAL_RATE_LIMIT_PER_MINUTE=300
ATTEST_RATE_LIMIT_PER_MINUTE=30
SPHINCS_KEY_RATE_LIMIT_PER_MINUTE=12
SPHINCS_SIGN_RATE_LIMIT_PER_MINUTE=20
SPHINCS_CONCURRENCY=2
STATS_CACHE_TTL_MS=15000
PROOFS_CACHE_TTL_MS=15000
LIQUIDITY_CACHE_TTL_MS=30000
CACHE_STALE_MS=120000
PROOF_CACHE_MAX_RECORDS=10000

# SPHINCS verification
SPHINCS_VERIFY_MODE=command
SPHINCS_VERIFY_COMMAND=python3 backend/verifier/verify_sphincsminus.py {pubkey} {message_b64} {signature}

# Optional production checks/docs
ETHERSCAN_API_KEY=
