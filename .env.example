CHALLENGE_TTL_MS=600000
SIGNER_PRIVATE_KEY=

# Preview mode
SPHINCS_VERIFY_MODE=preview
SPHINCS_VERIFY_COMMAND=

# Command mode on Windows
# SPHINCS_VERIFY_MODE=command
# SPHINCS_VERIFY_COMMAND=python backend/verifier/verify_sphincsminus.py {pubkey} {message_b64} {signature}

# If your Windows Python launcher is py:
# SPHINCS_VERIFY_COMMAND=py backend/verifier/verify_sphincsminus.py {pubkey} {message_b64} {signature}

# Sepolia deploy settings
# Get a Sepolia RPC URL from Alchemy/Infura/QuickNode or another RPC provider.
SEPOLIA_RPC_URL=

# Private key of the wallet that deploys contracts on Sepolia.
# Use a test wallet only. Do not paste a wallet with real mainnet funds here.
SEPOLIA_PRIVATE_KEY=

# Optional. If empty, deploy script uses the deployer as owner/reserve/backend signer for testnet.
CONTRACT_OWNER_ADDRESS=
LP_RESERVE_RECIPIENT=
TREASURY_RESERVE_RECIPIENT=
BACKEND_SIGNER_ADDRESS=

# Mainnet deploy settings for later, not needed for Sepolia testing.
MAINNET_RPC_URL=
MAINNET_PRIVATE_KEY=
MAINNET_DEPLOY_CONFIRM=

